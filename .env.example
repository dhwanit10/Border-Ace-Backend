# PostgreSQL connection
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=document_screening

# For BootStrap Admin
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=password
BOOTSTRAP_ADMIN_NAME=System Administrator
BOOTSTRAP_ADMIN_DOB=2000-01-01
BOOTSTRAP_ADMIN_GENDER=NA
BOOTSTRAP_ADMIN_AADHAR=000000000000
BOOTSTRAP_ADMIN_PHONE=9999999999
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_FACE_IMAGE=image_path

# For Bootstrap System
BOOTSTRAP_SYSTEM_NAME=SYSTEM-01

# JWT authentication
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Sepolia blockchain
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/your-infura-project-id
BLOCKCHAIN_PRIVATE_KEY=replace-with-the-wallet-private-key
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
